# Run before ESP-IDF loads sdkconfig. Defaults alone cannot migrate a generated
# configuration that already selected another cache-workaround strategy.
get_filename_component(SOLAR_OS_CLASSIC_PSRAM_DEFAULTS
    "${CMAKE_CURRENT_LIST_DIR}/../sdkconfig.defaults.esp32_psram" ABSOLUTE)

function(solar_os_enable_classic_psram_workaround)
    if(DEFINED SDKCONFIG_DEFAULTS)
        set(defaults ${SDKCONFIG_DEFAULTS})
    else()
        set(defaults sdkconfig.defaults)
    endif()
    if(SDKCONFIG)
        get_filename_component(config "${SDKCONFIG}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
    else()
        set(config "${CMAKE_SOURCE_DIR}/sdkconfig")
    endif()
    set(contents "")
    if(EXISTS "${config}")
        file(READ "${config}" contents)
    endif()
    set(target "${IDF_TARGET}")
    if(NOT target AND contents MATCHES "(^|\n)CONFIG_IDF_TARGET=\"([^\"]+)\"")
        set(target "${CMAKE_MATCH_2}")
    endif()
    if(NOT target)
        foreach(default IN LISTS defaults)
            get_filename_component(default "${default}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
            if(EXISTS "${default}")
                file(STRINGS "${default}" line REGEX "^CONFIG_IDF_TARGET=")
                if(line MATCHES "=\"([^\"]+)\"")
                    set(target "${CMAKE_MATCH_1}")
                endif()
            endif()
        endforeach()
    endif()
    if(NOT target STREQUAL "esp32")
        return()
    endif()
    list(FIND defaults "${SOLAR_OS_CLASSIC_PSRAM_DEFAULTS}" workaround_index)
    if(workaround_index EQUAL -1)
        list(APPEND defaults "${SOLAR_OS_CLASSIC_PSRAM_DEFAULTS}")
    endif()
    set(SDKCONFIG_DEFAULTS "${defaults}" PARENT_SCOPE)
    if(NOT EXISTS "${config}")
        return() # Fresh configurations consume the appended defaults.
    endif()
    if(contents MATCHES "(^|\n)CONFIG_IDF_TARGET=\"([^\"]+)\"" AND
       NOT CMAKE_MATCH_2 STREQUAL "esp32")
        return() # ESP-IDF handles a stale configuration for another target.
    endif()
    if(NOT contents MATCHES "(^|\n)CONFIG_SPIRAM=y(\n|$)")
        return()
    endif()
    set(minimum_revision 0)
    if(contents MATCHES "(^|\n)CONFIG_ESP32_REV_MIN_FULL=([0-9]+)")
        set(minimum_revision "${CMAKE_MATCH_2}")
    elseif(contents MATCHES "(^|\n)CONFIG_ESP32_REV_MIN=([0-9]+)")
        math(EXPR minimum_revision "${CMAKE_MATCH_2} * 100")
    endif()
    if(NOT minimum_revision LESS 300)
        return()
    endif()
    if(contents MATCHES "(^|\n)CONFIG_SPIRAM_CACHE_WORKAROUND=y(\n|$)" AND
       contents MATCHES "(^|\n)CONFIG_SPIRAM_CACHE_WORKAROUND_STRATEGY_DUPLDST=y(\n|$)" AND
       NOT contents MATCHES "(^|\n)CONFIG_SPIRAM_CACHE_WORKAROUND_STRATEGY_(MEMW|NOPS)=y(\n|$)")
        return()
    endif()
    get_filename_component(config_name "${config}" NAME)
    if(config_name MATCHES "^sdkconfig\\.defaults($|\\.)")
        message(FATAL_ERROR "SDKCONFIG must select a generated configuration, not defaults: ${config}")
    endif()
    string(REGEX REPLACE
        "(^|\n)(# CONFIG_SPIRAM_CACHE_WORKAROUND(_STRATEGY_(MEMW|DUPLDST|NOPS))? is not set|CONFIG_SPIRAM_CACHE_WORKAROUND(_STRATEGY_(MEMW|DUPLDST|NOPS))?=[^\n]*)"
        "\\1" contents "${contents}")
    file(WRITE "${config}" "${contents}\nCONFIG_SPIRAM_CACHE_WORKAROUND=y\nCONFIG_SPIRAM_CACHE_WORKAROUND_STRATEGY_DUPLDST=y\n")
    message(NOTICE "SolarOS enabling duplicate load/store PSRAM workaround in ${config}")
endfunction()

function(solar_os_check_classic_psram_workaround)
    if(NOT CONFIG_IDF_TARGET_ESP32 OR NOT CONFIG_SPIRAM)
        return()
    endif()
    if(DEFINED CONFIG_ESP32_REV_MIN_FULL AND NOT CONFIG_ESP32_REV_MIN_FULL LESS 300)
        return()
    endif()
    if(NOT CONFIG_SPIRAM_CACHE_WORKAROUND OR
       NOT CONFIG_SPIRAM_CACHE_WORKAROUND_STRATEGY_DUPLDST OR
       NOT CONFIG_SPIRAM_WORKAROUND_NEED_VOLATILE_SPINLOCK)
        message(FATAL_ERROR "Classic ESP32 PSRAM requires the duplicate load/store workaround and its SDK spinlock configuration")
    endif()
endfunction()
