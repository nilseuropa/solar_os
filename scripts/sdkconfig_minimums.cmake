# Defaults do not override values in an existing generated sdkconfig. Raise
# integer stack sizes that the selected defaults require, keeping any larger
# local value and every other setting. Run before ESP-IDF loads sdkconfig.
function(solar_os_apply_sdkconfig_minimums)
    if(DEFINED SDKCONFIG_DEFAULTS)
        set(defaults ${SDKCONFIG_DEFAULTS})
    else()
        set(defaults sdkconfig.defaults)
    endif()
    if(SDKCONFIG)
        get_filename_component(config "${SDKCONFIG}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
    else()
        set(config "${CMAKE_SOURCE_DIR}/sdkconfig")
    endif()
    if(NOT EXISTS "${config}")
        return()
    endif()
    # KEY or KEY:DEPRECATED_ALIAS (the alias line is dropped so it cannot win)
    foreach(item IN ITEMS CONFIG_ESP_MAIN_TASK_STACK_SIZE:CONFIG_MAIN_TASK_STACK_SIZE)
        string(REPLACE ":" ";" item "${item}")
        list(GET item 0 key)
        list(LENGTH item item_len)
        set(alias "")
        if(item_len GREATER 1)
            list(GET item 1 alias)
        endif()
        set(wanted 0)
        foreach(default IN LISTS defaults)
            get_filename_component(default "${default}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
            if(EXISTS "${default}")
                file(STRINGS "${default}" line REGEX "^${key}=[0-9]+$")
                if(line MATCHES "=([0-9]+)$")
                    set(wanted ${CMAKE_MATCH_1}) # later files win, as in ESP-IDF
                endif()
            endif()
        endforeach()
        if(wanted EQUAL 0)
            continue()
        endif()
        file(STRINGS "${config}" line REGEX "^${key}=[0-9]+$")
        set(current 0)
        if(line MATCHES "=([0-9]+)$")
            set(current ${CMAKE_MATCH_1})
        endif()
        if(NOT current LESS wanted)
            continue()
        endif()
        get_filename_component(config_name "${config}" NAME)
        if(config_name MATCHES "^sdkconfig\\.defaults($|\\.)")
            message(FATAL_ERROR "SDKCONFIG must select a generated configuration, not defaults: ${config}")
        endif()
        file(READ "${config}" contents)
        string(REGEX REPLACE "(^|\n)${key}=[^\n]*" "\\1" contents "${contents}")
        if(alias)
            string(REGEX REPLACE "(^|\n)${alias}=[^\n]*" "\\1" contents "${contents}")
        endif()
        file(WRITE "${config}" "${contents}\n${key}=${wanted}\n")
        message(NOTICE "SolarOS raising ${key} to ${wanted} in ${config}")
    endforeach()
endfunction()
