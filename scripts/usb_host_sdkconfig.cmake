# Existing generated configurations take precedence over SDK defaults. Enable
# hubs when required by the selected defaults without resetting local settings.
# Run before ESP-IDF loads sdkconfig and selects the USB component sources.
function(solar_os_enable_required_usb_hubs)
    if(DEFINED SDKCONFIG_DEFAULTS)
        set(defaults ${SDKCONFIG_DEFAULTS})
    else()
        set(defaults sdkconfig.defaults)
    endif()
    set(required FALSE)
    foreach(default IN LISTS defaults)
        get_filename_component(default "${default}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
        if(EXISTS "${default}")
            file(STRINGS "${default}" setting
                REGEX "^(CONFIG_USB_HOST_HUBS_SUPPORTED=[yn]|# CONFIG_USB_HOST_HUBS_SUPPORTED is not set)$")
            if(setting STREQUAL "CONFIG_USB_HOST_HUBS_SUPPORTED=y")
                set(required TRUE)
            elseif(setting)
                set(required FALSE)
            endif()
        endif()
    endforeach()
    if(NOT required)
        return()
    endif()
    if(SDKCONFIG)
        get_filename_component(config "${SDKCONFIG}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
    else()
        set(config "${CMAKE_SOURCE_DIR}/sdkconfig")
    endif()
    if(NOT EXISTS "${config}")
        return()
    endif()
    file(STRINGS "${config}" enabled REGEX "^CONFIG_USB_HOST_HUBS_SUPPORTED=y$")
    if(enabled)
        return()
    endif()
    get_filename_component(config_name "${config}" NAME)
    if(config_name MATCHES "^sdkconfig\\.defaults($|\\.)")
        message(FATAL_ERROR "SDKCONFIG must select a generated configuration, not defaults: ${config}")
    endif()
    file(READ "${config}" contents)
    string(REGEX REPLACE "(^|\n)(# CONFIG_USB_HOST_HUBS_SUPPORTED is not set|CONFIG_USB_HOST_HUBS_SUPPORTED=[^\n]*)" "\\1" contents "${contents}")
    file(WRITE "${config}" "${contents}\nCONFIG_USB_HOST_HUBS_SUPPORTED=y\n")
    message(NOTICE "SolarOS enabling USB host hubs in ${config}")
endfunction()
