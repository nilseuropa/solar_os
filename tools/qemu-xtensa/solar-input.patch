+        memory_region_add_subregion_overlap(sys_mem, SOLAR_OS_QEMU_HOSTFS_BASE,
+            sysbus_mmio_get_region(SYS_BUS_DEVICE(hostfs), 0), 0);
+    }
+
+    {
+        DeviceState *audio = qdev_new("solar-os-audio");
