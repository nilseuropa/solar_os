diff --git a/ui/input.c b/ui/input.c
index 7ddefeb..36998ba 100644
--- a/ui/input.c
+++ b/ui/input.c
@@ -122,6 +122,16 @@ qemu_input_find_handler(uint32_t mask, QemuConsole *con)
     return NULL;
 }
 
+void qemu_input_event_focus(QemuConsole *con, bool focused)
+{
+    QemuInputHandlerState *s;
+    QTAILQ_FOREACH(s, &handlers, node) {
+        if ((!s->con || s->con == con) && s->handler->focus) {
+            s->handler->focus(s->dev, focused);
+        }
+    }
+}
+
 void qmp_input_send_event(const char *device,
                           bool has_head, int64_t head,
                           InputEventList *events, Error **errp)
diff --git a/ui/sdl2.c b/ui/sdl2.c
